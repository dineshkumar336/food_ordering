# Copy to .env and fill in. Never commit the real .env file.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/food_ordering

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long a normal login lasts (the limited "set up two-step sign-in" token always lasts 10 minutes)
JWT_EXPIRES_IN=60m

# Name shown in the authenticator app
TOTP_ISSUER=Food Ordering

# Lockout after this many wrong passwords/codes, for this many minutes
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Set to 1 only when running behind a reverse proxy you control, so rate limits see real client IPs
# TRUST_PROXY=1
